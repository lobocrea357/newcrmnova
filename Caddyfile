# ============================================
# Caddyfile - CRM WhatsApp con WAHA Plus
# ============================================
# Configuración de reverse proxy con HTTPS automático
# ============================================

# WAHA Dashboard
waha.lobocrea.pro {
    reverse_proxy localhost:3000
    
    # Headers para WebSocket (necesario para QR en tiempo real)
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }
    
    # Logs
    log {
        output file /var/log/caddy/waha.log
        format json
    }
}

# Express API
api.lobocrea.pro {
    reverse_proxy localhost:4000
    
    # CORS manejado por Express (src/index.js)
    # No agregar headers CORS aquí para evitar duplicados
    
    # Logs
    log {
        output file /var/log/caddy/api.log
        format json
    }
}

# Dashboard CRM
crm.lobocrea.pro {
    reverse_proxy localhost:3001
    
    # Headers para Next.js
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    
    # Logs
    log {
        output file /var/log/caddy/crm.log
        format json
    }
}

