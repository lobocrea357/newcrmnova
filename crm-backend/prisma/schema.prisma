  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotizacion_id   String       @db.Uuid
  estado_anterior String?
  estado_nuevo    String
  changed_by      String       @db.Uuid
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  razon           String?
  users           users        @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cotizaciones    cotizaciones @relation(fields: [cotizacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
