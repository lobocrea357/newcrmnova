generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agencias {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String             @unique @db.VarChar
  codigo           String             @unique @db.VarChar
  descripcion      String?
  logo_url         String?
  color_primario   String?            @default("#6366f1") @db.VarChar
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  usuario_agencias usuario_agencias[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anulables {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  vuelo_id          String?   @db.Uuid
  pax_nombre        String
  contacto_nombre   String?
  contacto_telefono String?
  fecha_vuelo       DateTime? @db.Date
  ruta              String?
  localizador       String?
  estado_anulacion  String?   @default("PENDIENTE")
  fecha_limite      DateTime? @db.Date
  fecha_anulacion   DateTime? @db.Date
  monto_recuperado  Decimal?  @db.Decimal
  motivo_anulacion  String?
  observaciones     String?
  asignado_a        String?   @db.Uuid
  vuelos            vuelos?   @relation(fields: [vuelo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model auditoria_cambios_estado {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidad_tipo   String    @db.VarChar
  entidad_id     String    @db.Uuid
  campo_cambiado String    @db.VarChar
  valor_anterior String?   @db.VarChar
  valor_nuevo    String    @db.VarChar
  usuario_id     String?   @db.Uuid
  usuario_nombre String?   @db.VarChar
  razon_cambio   String?
  ip_address     String?   @db.Inet
  fecha_cambio   DateTime? @default(now()) @db.Timestamptz(6)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  profiles       profiles? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bookings {
  loc                      String    @id
  fecha_registro_venta     DateTime? @db.Timestamptz(6)
  fecha_salida_vuelo       DateTime? @db.Date
  origen_codigo            String?
  destino_codigo           String?
  ruta_completa            String?
  numero_vuelo             String?
  aerolinea                String?
  paradas_o_escalas        String?
  duracion_vuelo           String?
  equipaje_incluido        String?
  estado_reserva           String?
  tipo_servicio            String?
  proveedor                String?
  agente_venta             String?
  pax_total                Int?
  pasajeros_nombres        String?
  pasajeros_ticket_numbers String?
  venta_total_usd          Decimal?  @db.Decimal
  costo_base_usd           Decimal?  @db.Decimal
  emision_fee_usd          Decimal?  @db.Decimal
  hostal_usd               Decimal?  @db.Decimal
  fee_agencia_usd          Decimal?  @db.Decimal
  total_boleto_usd         Decimal?  @db.Decimal
  vuelto_usd               Decimal?  @db.Decimal
  pago_status              String?
  metodo_pago              String?
  cuenta_pago              String?
  last_updated_source      String?
  created_at               DateTime? @default(now()) @db.Timestamptz(6)
  updated_at               DateTime? @default(now()) @db.Timestamptz(6)
}

model bot_stats {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bot_id            String?   @db.Uuid
  date              DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  messages_sent     Int?      @default(0)
  messages_received Int?      @default(0)
  media_sent        Int?      @default(0)
  media_received    Int?      @default(0)
  errors_count      Int?      @default(0)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  bots              bots?     @relation(fields: [bot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bots {
  id                       String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                     String
  phone_number             String
  status                   String?                    @default("offline")
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  session_name             String?                    @unique
  engine                   String?                    @default("NOWEB")
  qr_code                  String?
  last_seen                DateTime?                  @db.Timestamptz(6)
  metadata                 Json?                      @default("{}")
  worker_id                String?                    @db.Uuid
  bot_stats                bot_stats[]
  workers                  workers?                   @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chats                    chats[]
  contacts                 contacts[]
  conversation_evaluations conversation_evaluations[]
  media_files              media_files[]
  messages                 messages[]
  performance_analyses     performance_analyses[]
  tags                     tags[]
  webhook_events           webhook_events[]
}

model chats {
  id                       String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bot_id                   String?                    @db.Uuid
  contact_number           String
  contact_name             String?
  unread_count             Int?                       @default(0)
  last_message             String?
  last_message_at          DateTime?                  @db.Timestamptz(6)
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  chat_id                  String?
  contact_id               String?                    @db.Uuid
  is_group                 Boolean?                   @default(false)
  archived                 Boolean?                   @default(false)
  pinned                   Boolean?                   @default(false)
  muted                    Boolean?                   @default(false)
  metadata                 Json?                      @default("{}")
  last_message_time        DateTime?                  @db.Timestamptz(6)
  name                     String?                    @db.VarChar
  ai_analysis              Json?                      @default("{}")
  bots                     bots?                      @relation(fields: [bot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts                 contacts?                  @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conversation_evaluations conversation_evaluations[]
  conversation_metrics     conversation_metrics?
  messages                 messages[]
}

model contact_notes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id String?   @db.Uuid
  note       String
  created_by String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  contacts   contacts? @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contact_tags {
  contact_id String    @db.Uuid
  tag_id     String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  contacts   contacts  @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tags       tags      @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([contact_id, tag_id])
}

model contacts {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bot_id              String?         @db.Uuid
  phone_number        String
  name                String?
  push_name           String?
  is_business         Boolean?        @default(false)
  is_enterprise       Boolean?        @default(false)
  profile_picture_url String?
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?       @default(now()) @db.Timestamptz(6)
  metadata            Json?           @default("{}")
  chats               chats[]
  contact_notes       contact_notes[]
  contact_tags        contact_tags[]
  bots                bots?           @relation(fields: [bot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages            messages[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversation_evaluations {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id                 String                @db.Uuid
  bot_id                  String                @db.Uuid
  worker_id               String?               @db.Uuid
  evaluation_date         DateTime?             @default(now()) @db.Timestamptz(6)
  generated_by            String
  manually_edited         Boolean?              @default(false)
  evaluated_by_user_id    String?               @db.Uuid
  tiempo_contacto         Boolean?              @default(false)
  tiempo_respuesta        Boolean?              @default(false)
  tiempo_cotizacion       Boolean?              @default(false)
  cierre_intencion        Boolean?              @default(false)
  ofrecio_scalapay        Boolean?              @default(false)
  mas_dos_opciones        Boolean?              @default(false)
  seguimiento_intencion   Boolean?              @default(false)
  score                   Int                   @default(0)
  max_score               Int                   @default(7)
  percentage              Decimal               @default(0.00) @db.Decimal
  ai_feedback             String?
  manager_notes           String?
  created_at              DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?             @default(now()) @db.Timestamptz(6)
  performance_analysis_id String?               @db.Uuid
  venta_confirmada        Boolean?              @default(false)
  lead_caliente           Boolean?              @default(false)
  cotizacion_enviada      Boolean?              @default(false)
  metodo_pago_enviado     Boolean?              @default(false)
  objeciones_superadas    Boolean?              @default(false)
  seguimiento_efectivo    Boolean?              @default(false)
  urgencia_creada         Boolean?              @default(false)
  valor_agregado          Boolean?              @default(false)
  score_ventas            Int?                  @default(0)
  percentage_ventas       Decimal?              @default(0.00) @db.Decimal
  valor_venta             Decimal?              @db.Decimal
  valor_estimado          Decimal?              @db.Decimal
  interest_level          String?               @default("bajo") @db.VarChar
  resultado_comercial     Json?                 @default("{}")
  exitos_asesor           String[]
  errores_criticos        String[]
  siguiente_accion        String?
  confidence_score        Decimal?              @default(0.00) @db.Decimal
  analysis_method         String?               @default("hybrid") @db.VarChar
  analysis_version        String?               @default("v2.0") @db.VarChar
  lead_respondio          Boolean?              @default(false)
  preguntas_negociacion   Boolean?              @default(false)
  numero_telefono         String?
  calidad_cotizacion      Boolean?              @default(false)
  bots                    bots                  @relation(fields: [bot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chats                   chats                 @relation(fields: [chat_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles                profiles?             @relation(fields: [evaluated_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "conversation_evaluations_evaluated_by_fkey")
  performance_analyses    performance_analyses? @relation(fields: [performance_analysis_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workers                 workers?              @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model conversation_metrics {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id                   String    @unique @db.Uuid
  total_messages            Int       @default(0)
  incoming_messages         Int       @default(0)
  outgoing_messages         Int       @default(0)
  avg_response_time_minutes Decimal?  @db.Decimal
  max_response_time_minutes Decimal?  @db.Decimal
  response_samples          Int?      @default(0)
  payment_mentions_count    Int?      @default(0)
  payment_first_mention_at  DateTime? @db.Timestamptz(6)
  payment_last_mention_at   DateTime? @db.Timestamptz(6)
  payment_last_from_me      Boolean?
  cotizacion_mentions_count Int?      @default(0)
  cotizacion_files          Json?     @default("[]")
  last_calculated_at        DateTime? @default(now()) @db.Timestamptz(6)
  created_at                DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                DateTime? @default(now()) @db.Timestamptz(6)
  chats                     chats     @relation(fields: [chat_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

