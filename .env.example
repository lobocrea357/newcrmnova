# ============================================
# WAHA PLUS - Seguridad
# ============================================
# API Key para autenticar requests a WAHA
WAHA_API_KEY=your_secure_api_key_here

# Credenciales para el dashboard de WAHA (http://localhost:3000)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_secure_password_here

# Credenciales para Swagger UI
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_secure_password_here

# Habilitar/Deshabilitar interfaces
WAHA_DASHBOARD_ENABLED=true
WHATSAPP_SWAGGER_ENABLED=true

# ============================================
# WAHA PLUS - Configuración General
# ============================================
# Engine de WhatsApp (NOWEB recomendado para producción)
# Opciones: WEBJS, NOWEB, VENOM
WHATSAPP_DEFAULT_ENGINE=NOWEB

# URL base de WAHA
# Para VPS: usa tu dominio o IP pública (ej: https://tu-dominio.com)
# Para desarrollo local: http://localhost:3000
WAHA_BASE_URL=http://localhost:3000

# Versión de WAHA Plus
WAHA_PLUS_VERSION=latest

# ============================================
# WAHA PLUS - Logging
# ============================================
# Formato de logs: PRETTY (desarrollo) o JSON (producción)
WAHA_LOG_FORMAT=PRETTY

# Nivel de logs: debug, info, warn, error
WAHA_LOG_LEVEL=info

# Imprimir códigos QR en los logs (útil para desarrollo)
WAHA_PRINT_QR=false

# ============================================
# WAHA PLUS - Almacenamiento de Medios
# ============================================
# Tipo de almacenamiento: LOCAL, S3, etc.
WAHA_MEDIA_STORAGE=LOCAL

# Tiempo de vida de archivos (0 = permanente)
WHATSAPP_FILES_LIFETIME=0

# Carpeta para archivos (dentro del contenedor)
WHATSAPP_FILES_FOLDER=/app/.media

# ============================================
# WAHA PLUS - Webhooks
# ============================================
# URL del webhook (Express API)
# Docker Compose: http://express:4000/webhooks/waha
# Desarrollo local: http://host.docker.internal:4000/webhooks/waha
WHATSAPP_HOOK_URL=http://express:4000/webhooks/waha

# Eventos a enviar al webhook
WHATSAPP_HOOK_EVENTS=session.status,message,message.ack,message.reaction

# ============================================
# EXPRESS API - Servidor Backend
# ============================================
# Puerto del servidor Express
PORT=4000

# ============================================
# SUPABASE - Base de Datos
# ============================================
# URL de tu proyecto Supabase
SUPABASE_URL=https://your-project.supabase.co

# Service Role Key (para el backend Express)
# IMPORTANTE: Usar SERVICE_ROLE_KEY, NO ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Bucket de almacenamiento para archivos multimedia
SUPABASE_STORAGE_BUCKET=whatsapp

# ============================================
# SUPABASE - Frontend (Dashboard)
# ============================================
# URL pública de Supabase (para el dashboard Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key (clave pública para el frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# OPENAI - Transcripción de Audios (Opcional)
# ============================================
# API Key de OpenAI para transcribir mensajes de voz
# Dejar vacío si no se necesita esta funcionalidad
OPENAI_API_KEY=your_openai_api_key_here
